# Public local Supabase values (safe to expose only as public keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Server-only. Use the local Supabase database URL with the limited knowledge_runtime role.
DATABASE_URL=postgresql://knowledge_runtime:replace-with-64-hex-password@127.0.0.1:54322/postgres

# Server-side Storage and local bootstrap only. Read the local service_role key and admin database URL from
# `supabase status`; never use values from a hosted project here.
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
SUPABASE_SECRET_KEY=replace-with-local-service-role-key
SUPABASE_DB_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
KNOWLEDGE_RUNTIME_PASSWORD=replace-with-64-hex-password
LOCAL_OWNER_EMAIL=owner@example.test
LOCAL_OWNER_PASSWORD=replace-with-a-local-only-password-at-least-20-chars
