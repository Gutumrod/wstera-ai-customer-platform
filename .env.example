# Public local Supabase values (safe to expose only as public keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Web Chat visitor sessions (server-only). Replace locally with a random value of at least 32 bytes.
WEB_CHAT_SESSION_SECRET=replace-with-random-secret-at-least-32-bytes
# Optional: set only when requests arrive through a proxy that overwrites this header.
# WEB_CHAT_TRUSTED_IP_HEADER=x-forwarded-for
# Comma-separated exact origins for the synthetic local seed; unset means deny every origin.
# WEB_CHAT_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Server-only. Use the local Supabase database URL with the limited knowledge_runtime role.
DATABASE_URL=postgresql://knowledge_runtime:replace-with-64-hex-password@127.0.0.1:54322/postgres

# Server-side Storage and local bootstrap only. Read the local service_role key and admin database URL from
# `supabase status`; never use values from a hosted project here.
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
SUPABASE_SECRET_KEY=replace-with-local-service-role-key
# postgres:postgres is the Supabase CLI's published local default; the seed script accepts it on loopback only.
SUPABASE_DB_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
KNOWLEDGE_RUNTIME_PASSWORD=replace-with-64-hex-password
LOCAL_OWNER_EMAIL=owner@example.test
LOCAL_OWNER_PASSWORD=replace-with-a-local-only-password-at-least-20-chars

# Lab mode only (see README). Keep commented for local. APP_ENV and NEXT_PUBLIC_APP_ENV must both be lab.
# SUPABASE_PROJECT_REF=replace-with-20-character-project-ref
# NEXT_PUBLIC_SUPABASE_PROJECT_REF=replace-with-the-same-project-ref
# SUPABASE_DB_CA_CERT="replace-with-project-ca-certificate-pem"
# LAB_SEED_CONFIRM_PROJECT_REF=replace-with-the-same-project-ref

# Model-backed answers (server-only, OFF by default). Anything missing or invalid keeps answers extractive.
# AICP_MODEL_ANSWERS_ENABLED=true
# AICP_MODEL_PROVIDER_ID=
# AICP_MODEL_BASE_URL=
# AICP_MODEL_NAME=
# AICP_MODEL_API_KEY=
# Currency per million tokens; 0 is allowed for flat-rate providers.
# AICP_MODEL_PRICE_INPUT_PER_MTOK=
# AICP_MODEL_PRICE_OUTPUT_PER_MTOK=
# Per workspace per UTC day. Budget may be omitted only when both prices are 0.
# AICP_MODEL_DAILY_MAX_CALLS=
# AICP_MODEL_DAILY_BUDGET=
# Optional: AICP_MODEL_MAX_COMPLETION_TOKENS, AICP_MODEL_TIMEOUT_MS, AICP_MODEL_ALLOW_LOCAL_HTTP=true (loopback http only)
